# Copia aquest fitxer a .env i posa-hi les dades del teu projecte Supabase.
# Sense aquestes variables, l'app funciona en mode local (dades al navegador).
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXX

